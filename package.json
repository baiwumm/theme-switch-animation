{
  "name": "theme-switch-animation",
  "version": "0.0.0",
  "description": "Theme switch animation library built on the View Transitions API. Works with React 18+, Vue 3+, Next.js and Nuxt 3+.",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.mjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@nuxt/kit": ">=3",
    "react": ">=18",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@nuxt/kit": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:acceptance": "node scripts/cdp-consistency.mjs && node scripts/cdp-darkcycle.mjs && node scripts/cdp-hydration.mjs && node scripts/cdp-measure.mjs && node scripts/cdp-vue-rapid.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "keywords": [
    "theme",
    "dark-mode",
    "view-transitions",
    "animation",
    "react",
    "vue",
    "nextjs",
    "nuxt"
  ],
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "jsdom": "^30.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
